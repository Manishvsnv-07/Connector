------ Success Pop Up
const successMsg = document.getElementById("successMsg");
        successMsg.textContent = data.success;
        successMsg.classList.remove("hidden");

        setTimeout(() => {
            successMsg.classList.add("hidden");
        }, 3000);
        return;

------- Error Pop Up

const errorDiv = document.getElementById("errorMsg");
