<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Instagram</title>
    <link rel="stylesheet" href="output.css">
</head>

<body>

<% if(error.length > 0) { %>
    <div class="w-[15vw] fixed top-4 left-[42.5%] h-[5vh] rounded-md text-white font-bold bg-red-500 flex items-center justify-center z-50">
        <%= error %>
    </div>
<% } %>
    <div class="main w-full relative h-screen flex bg-zinc-900">
                <div class="left w-full xl:w-[55vw] h-screen bg-black flex flex-col justify-center items-center">
                    <img src="images/thumbnail.jpeg" class="h-[80vh] rounded-md" alt="">
                    <div class="flex gap-5 justify-center items-center">
                        <h1 class="text-white"><strong class="text-red-500">Creator</strong> And <strong>User</strong> First !</h1>
                        <a href="/mobilestart"><button class="inline xl:hidden h-[5vh] rounded-md bg-white text-black px-2 font-semibold hover:scale-[1.07] hover:cursor-pointer">Let's Go »</button></a>
                    </div>
                </div>
                <div
                    class="right xl:flex text-white text-xl w-[45vw] h-screen bg-transparent hidden flex-col items-center justify-center">
                    <form action="/login" method="post">
                        <div class="righttop w-full flex flex-col gap-7 my-7 justify-center items-center">
                            <h1 class="font-sans font-bold">Log Into Account</h1>
                            <input type="text" name="username"
                                class="border border-gray-500 bg-transparent px-3  w-xl h-13 rounded-md"
                                placeholder="Enter Username">
                            <input type="password" name="password"
                                class="border border-gray-500 bg-transparent px-3 rounded-md w-xl h-13"
                                placeholder="Password">
                            <button
                                class="bg-blue-700 px-2 py-2 w-xl rounded-md hover:scale-[1.02] hover:cursor-pointer">Login</button>
                        </div>
                    </form>
                    <div>
                        <h1>Or</h1>
                    </div>
                    <div class="rightbottom flex flex-col justify-center gap-7 my-5 items-center">
                        <a href="/create">
                            <button
                                class="rounded-3xl w-xl bg-transparent h-13 px-2 py-2 border hover:scale-[1.02] hover:cursor-pointer border-gray-500">Create
                                An Account</a>
                        </form>
                    </div>
                </div>
    </div>
</body>

</html>