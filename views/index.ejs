<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Connector</title>
    <link rel="stylesheet" href="output.css">
    <link rel="icon" type="image/png" href="/images/logo.png">
</head>

<body>

    <% if(error.length> 0) { %>
        <div
            class="fixed top-4 px-2 left-[42.5%] h-[5vh] rounded-md text-white font-bold bg-red-500 flex items-center justify-center z-50">
            <%= error %>
        </div>
        <% } %>
            <div class="main w-full relative h-screen flex bg-[#9e8bc4]">
                <div class="left w-full xl:w-[55vw] h-screen bg-black flex flex-col justify-center items-center">
                    <img src="images/logo.png" class="h-[80vh]" alt="">
                    <div class="flex gap-5 w-full justify-center items-center">
                        <h1 class="text-white"><strong class="text-red-500">Creators</strong> And <strong>Users</strong>
                            First !</h1>
                        <a href="/mobilestart"><button
                                class="inline xl:hidden h-[5vh] rounded-md bg-white text-black px-2 font-semibold hover:scale-[1.07] hover:cursor-pointer">Let's
                                Go »</button></a>
                    </div>
                </div>
                <div
                    class="right xl:flex text-black font-semibold w-[45vw] h-screen bg-transparent hidden flex-col items-center justify-center">
                    <form action="/login" method="post">
                        <div class="righttop w-full flex flex-col gap-7 my-7 justify-center items-center">
                            <h1 class="font-sans font-bold">Log Into Account</h1>
                            <input type="text" name="username"
                                class="border border-zinc-600 bg-transparent px-3 outline-none  w-xl h-13 rounded-md"
                                placeholder="Enter Username">
                            <div class="relative">
                                <input type="password" name="password" id="password"
                                    class="border border-zinc-600 bg-transparent px-3 outline-none rounded-md w-xl h-13"
                                    placeholder="Password">
                                <img src="images/viewoff.svg"
                                    class="w-5 absolute right-3 top-4 brightness-30 hover:scale-[1.07] hover:cursor-pointer"
                                    id="toggleviewoff" alt="">
                                <img src="images/view.svg"
                                    class="w-5 hidden absolute right-3 top-4 brightness-30 hover:scale-[1.07] hover:cursor-pointer"
                                    id="toggleviewon" alt="">
                            </div>

                            <button
                                class="bg-white px-2 py-2 w-xl rounded-md hover:scale-[1.02] hover:cursor-pointer text-black">Login</button>
                        </div>
                    </form>
                    <div>
                        <h1>Or</h1>
                    </div>
                    <a href="/create">
                        <div class="rightbottom flex flex-col justify-center gap-7 my-5 items-center">

                            <button
                                class="rounded-3xl w-xl bg-white h-13 px-2 py-2 border hover:scale-[1.02] hover:cursor-pointer border-zinc-600">Create
                                An Account
                        </div>
                    </a>
                </div>
            </div>
            <script>
                let toggleviewoff = document.getElementById("toggleviewoff")
                let toggleviewon = document.getElementById("toggleviewon")
                let inputpassword = document.getElementById("password")
                toggleviewoff?.addEventListener("click", () => {
                    inputpassword.type = "text"
                    toggleviewon.classList.remove("hidden")
                    toggleviewoff.classList.add("hidden")
                })
                toggleviewon?.addEventListener("click", () => {
                    inputpassword.type = "password"
                    toggleviewon.classList.add("hidden")
                    toggleviewoff.classList.remove("hidden")
                })
            </script>
</body>

</html>