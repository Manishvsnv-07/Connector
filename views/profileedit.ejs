<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Account</title>
    <link rel="stylesheet" href="/output.css">
</head>

<body>

    <% if(error.length> 0){ %>
        <div
            class="w-[20vw] fixed top-4 left-[42.5%] h-[5vh] rounded-md text-white font-bold bg-red-500 flex items-center justify-center z-50">
            <%= error %>
        </div>
        <% } %>

            <div class="main w-full h-screen flex text-white bg-zinc-900">
                <div class="left w-[14vw] h-screen flex flex-col justify-between items-center py-2 bg-zinc-900">
                    <div class="flex gap-5 flex-col justify-center items-center">
                        <button>Logo</button>
                        <a href="/home"
                            class="flex gap-3 items-center px-3 font-bold font-sans hover:scale-[1.05] hover:cursor-pointer bg-zinc-800 rounded-md w-[11vw] h-12"><img
                                src="/images/home.svg" class="rounded-full w-7" alt="">Home</a>
                        <a href="/Vclips"
                            class="flex gap-3 items-center px-3 font-bold font-sans hover:scale-[1.05] hover:cursor-pointer bg-zinc-800 rounded-md w-[11vw] h-12"><img
                                src="/images/Vclips.svg" class="w-5" alt="">Vclips</a>
                        <a href="/post"
                            class="flex gap-3 items-center px-3 font-bold font-sans hover:scale-[1.05] hover:cursor-pointer bg-zinc-800 rounded-md w-[11vw] h-12"><img
                                src="/images/post.svg" class="rounded-full w-7" alt="">post</a>
                        <a href="/Search"
                            class="flex gap-3 items-center px-3 font-bold font-sans hover:scale-[1.05] hover:cursor-pointer bg-zinc-800 rounded-md w-[11vw] h-12"><img
                                src="/images/Search.svg" class="w-5" alt="">Search</a>
                        <a href="/profile"
                            class="flex gap-3 items-center px-3 font-bold font-sans hover:scale-[1.05] hover:cursor-pointer bg-[#ab9ff27a] rounded-md w-[11vw] h-12"><img
                                src="<%= userdata.image %>" class="rounded-full w-7" alt="">Profile</a>
                    </div>
                    <a href="/logout"
                        class="flex gap-3 items-center px-3 font-bold font-sans hover:scale-[1.05] hover:cursor-pointer bg-red-600 rounded-md w-[11vw] h-12"><img
                            src="/images/logout.svg" class="rounded-full w-7" alt="">Logout</a>

                </div>
                <div
                    class="right w-[86vw] h-screen border flex justify-center items-center relative border-zinc-700 bg-zinc-900">
                    <form action="/update" method="post" enctype="multipart/form-data">
                        <div
                            class="editbio w-xl h-[70vh] bg-transparent border flex justify-center items-center gap-5 flex-col border-zinc-700 rounded-md ">
                            <div class="updateimg flex justify-center items-center gap-4">
                                <img id="previewimgatprofile" src="<%= userdata.image %>"
                                    class="rounded-full w-[7vw] h-[15vh]" alt="">
                                <input type="file" id="fileInputatprofile" name="dp" accept="image/*"
                                    class="w-[15vw] h-[7vh] border border-zinc-700 rounded-md font-sans font-bold px-2">
                            </div>
                            <input type="text"
                                class="w-[35vw] h-[7vh] border border-zinc-700 rounded-md font-sans font-bold px-2"
                                name="upname" placeholder="Update Name">
                            <input type="text"
                                class="w-[35vw] h-[7vh] border border-zinc-700 rounded-md font-sans font-bold px-2"
                                name="upusername" placeholder="Username">
                            <textarea name="updescription" name="updescription" placeholder="Bio"
                                class="resize-none w-[35vw] h-[17vh] border border-zinc-700 rounded-md font-sans font-bold px-2 "></textarea>
                            <button
                                class="rounded-md w-[11vw] h-[5vh] hover:scale-[1.1] hover:cursor-pointer bg-white text-black px-2 border border-zinc-700">Update</button>
                        </div>
                    </form>

                </div>
            </div>
            <script src="/script.js" defer></script>
</body>

</html>