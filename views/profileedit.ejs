<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Account</title>
    <link rel="stylesheet" href="/output.css">
</head>

<body>

    <% if(error.length> 0){ %>
        <div
            class="w-[20vw] fixed top-4 left-[42.5%] h-[5vh] rounded-md text-white font-bold bg-red-500 flex items-center justify-center z-50">
            <%= error %>
        </div>
        <% } %>

            <div class="main relative w-full h-screen flex text-white bg-zinc-900">
                <div
                    class="left sm:flex w-[14vw] h-screen hidden flex-col justify-between items-center py-2 bg-zinc-900">
                    <div class="flex gap-9 lg:gap-5 flex-col justify-center items-center">
                        <button>Logo</button>
                        <a href="/home"
                            class="flex gap-3 items-center px-3 font-bold font-sans hover:scale-[1.05] hover:cursor-pointer rounded-md bg-transparent lg:bg-zinc-800  lg:w-[11vw] h-12"><img
                                src="/images/home.svg" class="rounded-full w-11 lg:w-7" alt=""><span
                                class="hidden lg:inline">Home</span></a>
                        <a href="/Vclips"
                            class="flex gap-3 items-center px-3 font-bold font-sans hover:scale-[1.05] hover:cursor-pointer bg-transparent lg:bg-zinc-800 rounded-md lg:w-[11vw] h-12"><img
                                src="/images/Vclips.svg" class="w-8 lg:w-5" alt=""><span
                                class="hidden lg:inline">Vclips</span></a>
                        <a href="/post"
                            class="flex gap-3 items-center px-3 font-bold font-sans hover:scale-[1.05] hover:cursor-pointer bg-transparent lg:bg-zinc-800 rounded-md lg:w-[11vw] h-12"><img
                                src="/images/post.svg" class="rounded-full w-11 lg:w-7" alt=""><span
                                class="hidden lg:inline">Post</span></a>
                        <a href="/Search"
                            class="flex gap-3 items-center px-3 font-bold font-sans hover:scale-[1.05] hover:cursor-pointer bg-transparent lg:bg-zinc-800 rounded-md lg:w-[11vw] h-12"><img
                                src="/images/Search.svg" class="w-11 lg:w-7" alt=""><span
                                class="hidden lg:inline">Search</span></a>
                        <a href="/profile"
                            class="flex gap-3 items-center px-3 font-bold font-sans hover:scale-[1.05] hover:cursor-pointer bg-transparent lg:bg-[#ab9ff27a] rounded-md lg:w-[11vw] h-12"><img
                                src="<%= userdata.image %>" class="rounded-full w-11 lg:w-7" alt=""><span
                                class="hidden lg:inline">Profile</span></a>
                    </div>
                </div>
                <div class="right w-full h-screen border flex justify-center relative border-zinc-700 bg-zinc-900">
                    <div class="manage h-[90vh] sm:h-[98vh] flex flex-col gap-5 overflow-y-scroll ">
                        <form action="/update" method="post" enctype="multipart/form-data">
                            <div
                                class="editbio relative w-[90vw] sm:w-[50vw] md:w-[45vw] lg:w-[40vw] h-[70vh] bg-transparent border flex py-5 m-2 items-center gap-5 flex-col border-zinc-700 rounded-md ">
                                <div class="updateimg flex justify-center items-center gap-4">
                                    <img id="previewimgatprofile" src="<%= userdata.image %>"
                                        class="rounded-full w-[14vw]  sm:w-[7vw] h-[15vh]" alt="">
                                    <div class="relative w-[50vw] sm:w-[21vw] h-[7vh]">
                                        <button
                                            class="w-full h-full border border-zinc-700 rounded-md font-sans font-bold px-2">
                                            Choose Picture
                                        </button>
                                        <input type="file" id="fileInputatprofile" name="dp" accept="image/*"
                                            class="absolute inset-0 opacity-0 cursor-pointer w-full h-full">
                                    </div>
                                </div>
                                <input type="text"
                                    class="w-[60vw] sm:w-[35vw] h-[7vh] border border-zinc-700 rounded-md font-sans font-bold px-2"
                                    name="upname" placeholder="Update Name">
                                <input type="text"
                                    class="w-[60vw] sm:w-[35vw] h-[7vh] border border-zinc-700 rounded-md font-sans font-bold px-2"
                                    name="upusername" placeholder="Username">
                                <textarea name="updescription" name="updescription" placeholder="Bio"
                                    class="resize-none w-[60vw] sm:w-[35vw] h-[17vh] border border-zinc-700 rounded-md font-sans font-bold px-2 "></textarea>
                                <button
                                    class="rounded-md h-[5vh] hover:scale-[1.1] hover:cursor-pointer bg-white text-black px-2 border border-zinc-700">Update</button>
                            </div>
                        </form>

                        <div
                            class="logoutordisconnect w-[90vw] sm:w-[50vw] md:w-[45vw] lg:w-[40vw] flex flex-col justify-center items-start m-2 px-5 py-3 gap-5 border border-zinc-700 rounded-md">
                            <% if(!userdata.walletAddress=="" ){ %>
                                <div class="disconnectbox w-full flex flex-col sm:flex-row gap-7">
                                    <button
                                        class="disconnect rounded-md bg-[#ab9ff2] gap-1 h-[5vh] px-2 text-black text-[15px] hover:scale-[1.04] hover:cursor-pointer flex justify-center items-center"><img
                                            src="/images/phantom.svg" class="w-7 rounded-md" alt=""><span
                                            class="font-semibold">Disconnect</span></button>
                                    <div
                                        class="dissure hidden flex justify-center items-center gap-7 border border-zinc-700 w-full sm:w-[50%] py-1">
                                        <button
                                            class="canceldisconnect rounded-md border border-zinc-700 bg-zinc-900 px-2 hover:cursor-pointer hover:scale-[1.05]">Cancel</button>
                                        <a href="/profile/Disconnectphantom"
                                            class="rounded-md border border-zinc-700 bg-red-500 px-2 hover:cursor-pointer hover:scale-[1.05]">Sure</a>
                                    </div>
                                </div>
                                <% }%>
                                    <div class="logoutbox w-full flex flex-col sm:flex-row gap-7">
                                        <button
                                            class="logoutbtn flex gap-3 items-center px-3 font-bold font-sans hover:scale-[1.05] hover:cursor-pointer bg-red-600 rounded-md  h-12"><img
                                                src="/images/logout.svg" class="rounded-full w-7" alt="">Logout</button>
                                        <div
                                            class="logoutsure hidden flex justify-center items-center gap-4 sm:gap-7 border border-zinc-700 w-full sm:w-[50%] py-1">
                                            <button
                                                class="cancellogout rounded-md border border-zinc-700 bg-zinc-900 px-2 hover:cursor-pointer hover:scale-[1.05]">Cancel</button>
                                            <a href="/logout"
                                                class="rounded-md border border-zinc-700 bg-red-500 px-2 hover:cursor-pointer hover:scale-[1.05]">Confirm</a>
                                        </div>
                                    </div>

                        </div>
                    </div>

                </div>


                <div class="flex sm:hidden w-full justify-between px-2 absolute bottom-5">
                    <a href="/home"><img src="/images/home.svg" class="rounded-full w-9" alt=""></a>
                    <a href="/Vclips"><img src="/images/Vclips.svg" class="w-6" alt=""></a>
                    <a href="/post"><img src="/images/post.svg" class="rounded-full w-9" alt=""></a>
                    <a href="/Search"><img src="/images/Search.svg" class="w-9" alt=""></a>
                    <a href="/profile"><img src="<%= userdata.image %>" class="rounded-full w-9" alt=""></a>
                </div>

            </div>
            <script src="/script.js" defer></script>
</body>

</html>