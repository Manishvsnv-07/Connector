<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Search • Connector</title>
    <link rel="stylesheet" href="/output.css">
    <link rel="icon" type="image/png" href="/images/logo.png">
</head>

<body>
    <div class="main relative w-full h-screen flex flex-col sm:flex-row text-white bg-zinc-900">
        <div class="left sm:flex w-[14vw] h-screen hidden flex-col justify-between items-center py-2 bg-zinc-900">
            <div class="flex gap-9 lg:gap-5 flex-col justify-center items-center">
                <img src="images/logo.png" class="w-11 h-11 rounded-full" alt="">
                <a href="/home"
                    class="flex gap-3 items-center px-3 font-bold font-sans hover:scale-[1.05] hover:cursor-pointer rounded-md bg-transparent lg:bg-zinc-800  lg:w-[11vw] h-12"><img
                        src="images/home.svg" class="rounded-full w-11 lg:w-7" alt=""><span
                        class="hidden lg:inline">Home</span></a>
                <a href="/Vclips"
                    class="flex gap-3 items-center px-3 font-bold font-sans hover:scale-[1.05] hover:cursor-pointer bg-transparent lg:bg-zinc-800 rounded-md lg:w-[11vw] h-12"><img
                        src="images/Vclips.svg" class="w-8 lg:w-5" alt=""><span
                        class="hidden lg:inline">Vclips</span></a>
                <a href="/post"
                    class="flex gap-3 items-center px-3 font-bold font-sans hover:scale-[1.05] hover:cursor-pointer bg-transparent lg:bg-zinc-800 rounded-md lg:w-[11vw] h-12"><img
                        src="images/post.svg" class="rounded-full w-11 lg:w-7" alt=""><span
                        class="hidden lg:inline">Post</span></a>
                <% if(notifydata > 0){ %>
                        <a href="/Notify"
                            class="flex gap-3 items-center px-3 font-bold font-sans hover:scale-[1.05] hover:cursor-pointer bg-transparent lg:bg-zinc-800 rounded-md lg:w-[11vw] h-12"><img
                                src="images/notifyfalse.svg" class="rounded-full w-11 lg:w-7" alt=""><span
                                class="hidden lg:inline">Notify (<%= notifydata %>)</span></a>
                        <% } else { %>
                        <a href="/Notify"
                            class="flex gap-3 items-center px-3 font-bold font-sans hover:scale-[1.05] hover:cursor-pointer bg-transparent lg:bg-zinc-800 rounded-md lg:w-[11vw] h-12"><img
                                src="images/notify.svg" class="rounded-full w-11 lg:w-7" alt=""><span
                                class="hidden lg:inline">Notify</span></a>
                        <% } %>
                <a href="/Search"
                    class="flex gap-3 items-center px-3 font-bold font-sans hover:scale-[1.05] hover:cursor-pointer bg-transparent lg:bg-[#ab9ff27a] rounded-md lg:w-[11vw] h-12"><img
                        src="images/Search.svg" class="w-11 lg:w-7" alt=""><span
                        class="hidden lg:inline">Search</span></a>
                <a href="/profile"
                    class="flex gap-3 items-center px-3 font-bold font-sans hover:scale-[1.05] hover:cursor-pointer bg-transparent lg:bg-zinc-800 rounded-md lg:w-[11vw] h-12"><img
                        src="<%= userdata.image %>" class="rounded-full w-11 h-11 lg:w-7 lg:h-7" alt=""><span
                        class="hidden lg:inline">Profile</span></a>
            </div>
        </div>
        <div class="right w-full h-[91%] sm:h-screen border-l flex items-center justify-center border-zinc-700 bg-zinc-900">

            <div class="Searchbox w-[80vw] sm:w-[40vw] md:w-[40vw] xl:w-[30vw] h-full">
                <div class="searching relative p-2 flex justify-between items-center gap-2">
                    <input type="text" id="searchinput" placeholder="Search Your Friend"
                        class="w-full outline-none h-11 p-2 border border-zinc-700 rounded-md">
                    <img src="images/search.svg"
                        class="absolute right-5 w-5 sm:w-7 hover:scale-[1.1] hover:cursor-pointer brightness-50" alt="">
                </div>

                <div
                    class="searchedusers flex-1 h-[88%] border border-zinc-700 p-2 overflow-y-scroll [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden">
                </div>
            </div>
            <div
                class="followersTab hidden rounded-xl overflow-y-auto border border-zinc-800 bg-zinc-900 flex flex-col gap-3 px-3 py-2 absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 h-[60vh] w-[80vw] sm:w-[65vw] md:w-[50vw]">
                <div class="followerheader flex justify-between px-3">
                    <h1>Followers</h1>
                    <img src="/images/close.svg" id="removeFollowerTab"
                        class="w-5 hover:cursor-pointer hover:scale-[1.09]" alt="">
                </div>
                <% userdata.follower.reverse().forEach((f)=>{ %>
                    <div id="followyou-<%= f._id %>"
                        class="followyou w-full border border-zinc-700 h-14 px-3 shrink-0 flex gap-5 items-center justify-between">
                        <div class="flex gap-5">
                            <img src="<%= f.image %>" class="w-7 rounded-full" alt="">
                            <h1 onclick="searcheduserprofile('<%= f._id %>')"
                                class="font-semibold hover:cursor-pointer">
                                <%= f.username %>
                            </h1>
                        </div>
                        <% if(userdata.follower.some(id=> id.equals(userdata._id))){ %>
                            <button
                                class="px-2 bg-transparent border border-zinc-700 rounded-md font-semibold text-white hover:scale-[1.07] hover:cursor-pointer"
                                onclick="followuser('<%= userdata._id %>',this)">Unfollow</button>
                            <% } else{ %>
                                <button
                                    class="px-2 bg-transparent border border-zinc-700 rounded-md font-semibold text-white hover:scale-[1.07] hover:cursor-pointer"
                                    onclick="followuser('<%= userdata._id %>',this)">Follow</button>
                                <% } %>
                    </div>
                    <% }) %>
            </div>

            <div
                class="followingTab hidden rounded-xl overflow-y-auto border border-zinc-800 bg-zinc-900 flex flex-col gap-3 px-3 py-2 absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 h-[60vh] w-[80vw] sm:w-[65vw] md:w-[50vw]">
                <div class="followingheader flex justify-between px-3">
                    <h1>Followings</h1>
                    <img src="/images/close.svg" id="removeFollowingTab"
                        class="w-5 hover:cursor-pointer hover:scale-[1.09]" alt="">
                </div>
                <% userdata.following.reverse().forEach((fw)=>{ %>
                    <div id="youfollow-<%= fw._id %>"
                        class="youfollow w-full border border-zinc-700 h-14 px-3 shrink-0 flex gap-5 items-center justify-between">
                        <div class="flex gap-5">
                            <img src="<%= fw.image %>" class="w-7 rounded-full" alt="">
                            <h1 onclick="searcheduserprofile('<%= fw._id %>')"
                                class="font-semibold hover:cursor-pointer">
                                <%= fw.username %>
                            </h1>
                        </div>
                        <% if(userdata.follower.some(id=> id.equals(mydata._id))){ %>
                            <button
                                class="px-2 bg-transparent border border-zinc-700 rounded-md font-semibold text-white hover:scale-[1.07] hover:cursor-pointer"
                                onclick="followuser('<%= userdata._id %>',this)">Unfollow</button>
                            <% } else{ %>
                                <button
                                    class="px-2 bg-transparent border border-zinc-700 rounded-md font-semibold text-white hover:scale-[1.07] hover:cursor-pointer"
                                    onclick="followuser('<%= userdata._id %>',this)">Follow</button>
                                <% } %>
                    </div>
                    <% }) %>
            </div>
        </div>
        <div class="flex sm:hidden w-full justify-between px-2 h-[9%] items-center">
            <a href="/home"><img src="images/home.svg" class="rounded-full w-9" alt=""></a>
            <a href="/Vclips"><img src="images/Vclips.svg" class="w-6" alt=""></a>
            <a href="/post"><img src="images/post.svg" class="rounded-full w-9" alt=""></a>
            <a href="/Search"><img src="images/Search.svg" class="w-9" alt=""></a>
            <a href="/profile"><img src="<%= userdata.image %>" class="rounded-full w-9 h-9" alt=""></a>
        </div>
    </div>
    <script src="/js/search.js"></script>
    <script src="/js/utils.js"></script>
    <script src="/js/profile.js"></script>
</body>

</html>