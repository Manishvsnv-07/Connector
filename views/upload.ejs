<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= userdata.username %> • Connector
    </title>
    <link rel="stylesheet" href="output.css">
    <link rel="icon" type="image/png" href="/images/logo.png">
</head>

<body>

    <div id="errorMsg"
        class="hidden fixed left-1/2 top-7 -translate-x-1/2 -translate-y-1/2 h-[5vh] rounded-md  bg-red-500  border border-zinc-600  flex items-center justify-center z-50 px-2">
        <span class="te text-white"></span>
    </div>

    <div id="successMsg"
        class="hidden fixed left-1/2 top-7 -translate-x-1/2 -translate-y-1/2 h-[5vh] rounded-md  bg-green-300  border border-zinc-600  flex items-center justify-center z-50 px-2">
        <span class="ts text-black"></span>
    </div>
    <div id="PhantomMsg"
        class="hidden fixed left-1/2 top-7 -translate-x-1/2 -translate-y-1/2 h-[5vh] rounded-md  bg-[#ab9ff2]  border border-zinc-600  flex items-center justify-center z-50 px-2">
        <span class="p text-black"></span>
    </div>
    <div class="main relative w-full h-screen flex flex-col sm:flex-row text-white bg-zinc-900">
        <div class="left sm:flex w-[14vw] h-screen hidden flex-col justify-between items-center py-2 bg-zinc-900">
            <div class="flex gap-9 lg:gap-5 flex-col justify-center items-center">
                <img src="images/logo.png" class="w-11 rounded-full" alt="">
                <a href="/home"
                    class="flex gap-3 items-center px-3 font-bold font-sans hover:scale-[1.05] hover:cursor-pointer rounded-md bg-transparent lg:bg-zinc-800  lg:w-[11vw] h-12"><img
                        src="images/home.svg" class="rounded-full w-11 lg:w-7" alt=""><span
                        class="hidden lg:inline">Home</span></a>
                <a href="/Vclips"
                    class="flex gap-3 items-center px-3 font-bold font-sans hover:scale-[1.05] hover:cursor-pointer bg-transparent lg:bg-zinc-800 rounded-md lg:w-[11vw] h-12"><img
                        src="images/Vclips.svg" class="w-8 lg:w-5" alt=""><span
                        class="hidden lg:inline">Vclips</span></a>
                <a href="/post"
                    class="flex gap-3 items-center px-3 font-bold font-sans hover:scale-[1.05] hover:cursor-pointer bg-transparent lg:bg-[#ab9ff27a] rounded-md lg:w-[11vw] h-12"><img
                        src="images/post.svg" class="rounded-full w-11 lg:w-7" alt=""><span
                        class="hidden lg:inline">Post</span></a>
                <% if(notifydata> 0){ %>
                    <a href="/Notify"
                        class="flex gap-3 items-center px-3 font-bold font-sans hover:scale-[1.05] hover:cursor-pointer bg-transparent lg:bg-zinc-800 rounded-md lg:w-[11vw] h-12"><img
                            src="images/notifyfalse.svg" class="rounded-full w-11 lg:w-7" alt=""><span
                            class="hidden lg:inline">Notify (<%= notifydata %>)</span></a>
                    <% } else { %>
                        <a href="/Notify"
                            class="flex gap-3 items-center px-3 font-bold font-sans hover:scale-[1.05] hover:cursor-pointer bg-transparent lg:bg-zinc-800 rounded-md lg:w-[11vw] h-12"><img
                                src="images/notify.svg" class="rounded-full w-11 lg:w-7" alt=""><span
                                class="hidden lg:inline">Notify</span></a>
                        <% } %>
                            <a href="/Search"
                                class="flex gap-3 items-center px-3 font-bold font-sans hover:scale-[1.05] hover:cursor-pointer bg-transparent lg:bg-zinc-800 rounded-md lg:w-[11vw] h-12"><img
                                    src="images/Search.svg" class="w-11 lg:w-7" alt=""><span
                                    class="hidden lg:inline">Search</span></a>
                            <a href="/profile"
                                class="flex gap-3 items-center px-3 font-bold font-sans hover:scale-[1.05] hover:cursor-pointer bg-transparent lg:bg-zinc-800 rounded-md lg:w-[11vw] h-12"><img
                                    src="<%= userdata.image %>" class="rounded-full w-11 lg:w-7" alt=""><span
                                    class="hidden lg:inline">Profile</span></a>
            </div>
        </div>
        <div
            class="right  w-full h-[91%] sm:h-screen border flex items-center justify-center border-zinc-700 bg-zinc-900">

            <div
                class="uploadbox w-[80vw] h-[88vh] flex flex-col md:flex-row gap-7 overflow-y-auto [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden items-center rounded-md">

                <div class="flex justify-center items-center w-full md:w-1/2">
                    <img id="previewimg" src="images/upload.jpeg"
                        class="aspect-9/11 border border-zinc-700 rounded-md h-[60vh] object-contain" alt="">
                    <img id="thumbnailpreview"
                        class="hidden aspect-9/11 border border-zinc-700 rounded-md h-[70vh] object-cover" alt="">
                    <div class="videobox hidden relative">
                        <video id="videopreview"
                            class="aspect-9/11 border border-zinc-700 rounded-md h-[70vh] object-cover" autoplay muted
                            playsinline loop></video>

                        <img src="images/offsound.svg" class="vmusicoff absolute bottom-5 right-5 w-5" alt="">
                        <div
                            class="w-7 h-7 flex justify-center items-center bg-transparent border border-zinc-600 rounded-md absolute top-3 left-3 z-100">
                            <img src="images/edit.svg" class="w-5" alt="">
                            <input type="file" name="thumbnail" id="thumbnail" accept="image/*"
                                class="absolute inset-0 opacity-0 cursor-pointer">
                        </div>

                    </div>
                </div>

                <!-- CONTENT BOX -->
                <div class="content-D flex flex-col gap-7 w-full md:w-1/2">

                    <!-- FILE INPUT -->
                    <div class="relative w-full h-11 flex items-center justify-center">
                        <input type="file" id="fileInput" name="media" accept="image/*,video/*"
                            class="absolute inset-0 opacity-0 cursor-pointer z-10">

                        <button onclick="document.getElementById('fileInput').click()"
                            class="border border-zinc-700 h-11 w-full rounded-md">
                            Upload File
                        </button>
                    </div>

                    <!-- TEXTAREA -->
                    <textarea name="description" placeholder="About Your Content" id="description"
                        class="resize-none w-full h-[25vh] border outline-none border-zinc-700 rounded-md bg-transparent text-white p-2 overflow-y-auto"></textarea>

                    <!-- TAGS -->
                    <form id="uploadForm" action="/create" method="POST" enctype="multipart/form-data">
                        <div class="flex flex-col border border-zinc-700 rounded-lg px-3 py-2 gap-4">
                        <div id="tagsContainer" class="flex gap-2 cursor-text">
                            <input id="tagInput" placeholder="Tags will help your post go viral...."
                                class="border-none outline-none bg-transparent text-md w-full" />
                        </div>
                        <div id="tagPills" class="flex flex-wrap gap-3 mt-1"></div>
                    </div>
                    <p id="hintText" class="text-xs">Press <strong>Enter</strong> or <strong>,</strong> to add a tag;
                    </p>
                        <input type="hidden" name="tgs" id="tagsData" />
                    </form>
                    


                    <!-- POST AS A NFT OR NOT -->
                    <div class="flex gap-5 justify-start items-center">
                        <div class="relative tbox w-11 h-5 border bg-zinc-700 rounded-full">
                            <div class="tcircle absolute left-0 circle w-5 h-5 bg-white rounded-full">
                            </div>
                        </div>
                        <p class="text-zinc-500 tetx-xs">Toggle On If You Want To Post As <strong>NFT</strong></p>
                    </div>
                    <!-- BUTTON -->
                    <button type="submit" onclick="handleUpload()" id="upload"
                        class="bg-[#ab9ff2] text-black font-semibold rounded-md w-full h-11">
                        Post It
                    </button>

                </div>

            </div>
        </div>

        <div class="flex sm:hidden w-full justify-between px-2 h-[9%] items-center">
            <a href="/home"><img src="images/home.svg" class="rounded-full w-9" alt=""></a>
            <a href="/Vclips"><img src="images/Vclips.svg" class="w-6" alt=""></a>
            <a href="/post"><img src="images/post.svg" class="rounded-full w-9" alt=""></a>
            <a href="/Search"><img src="images/Search.svg" class="w-9" alt=""></a>
            <a href="/profile"><img src="<%= userdata.image %>" class="rounded-full w-9" alt=""></a>
        </div>

        <script src="/js/post.js" defer></script>
        <script src="https://unpkg.com/@solana/web3.js@latest/lib/index.iife.min.js"></script>
        <script src="/js/nft.js"></script>
</body>

</html>