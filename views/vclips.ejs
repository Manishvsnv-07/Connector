<!-- MAIN POST CONTAINER -->
<div
    class="post relative w-full h-[100dvh] snap-start shrink-0 flex justify-center items-center overflow-hidden bg-black">

    <!-- VIDEO FEED -->
    <div id="videoposts-<%= post._id %>"
        class="videoposts relative flex flex-col h-full w-full items-center justify-center">

        <!-- HEADER -->
        <div
            class="postheader absolute top-0 left-0 z-30 w-full px-3 py-3 flex justify-between items-center bg-gradient-to-b from-black/70 to-transparent">

            <div class="leftheader flex gap-3 items-center">
                <img src="<%= post.user.image %>" class="w-8 h-8 rounded-full object-cover" alt="">

                <a href="/home/<%= post.user._id %>"
                    class="text-gray-300 hover:text-white transition-all">

                    <div class="flex gap-2 items-center">
                        <h1 class="font-semibold text-sm">
                            @<%= post.user.username %>
                        </h1>

                        <% if(post.user.walletAddress){ %>
                            <img src="/images/phantom_verified.svg" class="w-5 h-5" alt="">
                        <% } %>
                    </div>

                </a>
            </div>

            <div class="rightheader">
                <% if(post.user._id.toString()===userdata._id.toString()){ %>

                <% } else { %>

                    <% if(post.user.follower.includes(userdata._id)){ %>

                        <button
                            class="px-3 py-1 border border-zinc-500 rounded-md text-sm font-semibold bg-black/40 backdrop-blur-sm hover:scale-[1.05] transition-all"
                            onclick="followuser('<%= post.user._id %>',this)">
                            Unfollow
                        </button>

                    <% } else{ %>

                        <button
                            class="px-3 py-1 border border-zinc-500 rounded-md text-sm font-semibold bg-black/40 backdrop-blur-sm hover:scale-[1.05] transition-all"
                            onclick="followuser('<%= post.user._id %>',this)">
                            Follow
                        </button>

                    <% } %>

                <% } %>
            </div>
        </div>

        <!-- VIDEO -->
        <div class="relative w-full h-[100dvh] overflow-hidden bg-black">

            <video src="<%= post.videos %>" autoplay muted loop poster="<%= post.thumbnail %>"
                data-id="<%= post._id %>"
                class="videoplay w-full h-full object-cover hover:cursor-pointer">
            </video>

            <!-- PLAY ICON -->
            <img src="images/play.svg"
                class="play hidden absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-12 z-20"
                alt="">


            <!-- DESCRIPTION -->
            <div
                class="absolute bottom-6 left-3 right-20 z-20 flex flex-col gap-2 text-white">

                <div class="flex items-center gap-2">
                    <h1 class="font-semibold text-sm">
                        @<%= post.user.username %>
                    </h1>

                    <% if(post.user.walletAddress){ %>
                        <img src="/images/phantom_verified.svg" class="w-4 h-4" alt="">
                    <% } %>
                </div>

                <p onclick="description('<%= post._id %>')" id="description-<%= post._id %>"
                    class="vdescription text-sm leading-5 line-clamp-2 overflow-hidden drop-shadow-lg hover:cursor-pointer">

                    <% let r=Math.random() %>

                    <% if(r>0.1 && r<0.2 ){ %>
                        <span class="text-blue-400">₥</span>
                    <% } else if(r>0.2 && r<0.3){ %>
                        <span class="text-blue-400">µ</span>
                    <% } else if(r>0.3){ %>
                        <span class="text-blue-400">✓</span>
                    <% } else if(r<0.1){ %>
                        <span class="text-blue-400">⌀</span>
                    <% } %>

                    <%= post.description %>

                </p>

            </div>

        </div>
    </div>

    <!-- RIGHT SIDE INTERACTION -->
    <div id="userinteract-<%= post._id %>"
        class="absolute right-3 bottom-24 z-30">

        <div class="likecommentmusic flex flex-col items-center justify-end gap-6 w-14">

            <!-- LIKE + COMMENT -->
            <div class="likeorcomment flex flex-col gap-6">

                <!-- LIKE -->
                <div class="like flex flex-col items-center gap-1">

                    <% if(post.likes.some(id=> (id._id || id).toString() ===
                        userdata._id.toString())){ %>

                        <img src="images/liked.svg"
                            class="likedv w-7 hover:scale-[1.1] hover:cursor-pointer"
                            data-id="<%= post._id %>"
                            onclick="likevpost('<%= post._id %>')">

                        <img src="images/unliked.svg"
                            class="unlikedv hidden w-7 hover:scale-[1.1] hover:cursor-pointer"
                            data-id="<%= post._id %>"
                            onclick="likevpost('<%= post._id %>')">

                    <% } else { %>

                        <img src="images/liked.svg"
                            class="likedv hidden w-7 hover:scale-[1.1] hover:cursor-pointer"
                            data-id="<%= post._id %>"
                            onclick="likevpost('<%= post._id %>')">

                        <img src="images/unliked.svg"
                            class="unlikedv w-7 hover:scale-[1.1] hover:cursor-pointer"
                            data-id="<%= post._id %>"
                            onclick="likevpost('<%= post._id %>')">

                    <% } %>

                    <h2 class="likevcount font-bold text-sm"
                        data-id="<%= post._id %>">
                        <%= post.likes.length %>
                    </h2>

                </div>

                <!-- COMMENT -->
                <div class="flex flex-col items-center gap-1">

                    <img src="images/comment.svg"
                        onclick="vopenbox(`<%= post._id %>`)"
                        class="comment w-7 hover:scale-[1.1] hover:cursor-pointer"
                        alt="">

                    <h2 class="commentcount font-bold text-sm"
                        data-id="<%= post._id %>">
                        <%= post.comments.length %>
                    </h2>

                </div>

            </div>

            <!-- SOUND + SOL -->
            <div class="flex flex-col items-center gap-5">

                <% if(post.image==="" ){ %>

                    <img src="images/offsound.svg"
                        class="playsound w-7 hover:scale-[1.1] hover:cursor-pointer hover:brightness-75"
                        alt="">

                <% } %>

                <% if(userdata.walletAddress && post.user.walletAddress){ %>

                    <% if(post.user._id.toString() !==userdata._id.toString()){ %>

                        <div>
                            <img src="images/solana.svg"
                                onclick="vopensol('<%= post._id %>')"
                                class="w-9 hover:scale-[1.1] hover:cursor-pointer"
                                alt="">
                        </div>

                    <% } %>

                <% } %>

            </div>

        </div>
    </div>

</div>