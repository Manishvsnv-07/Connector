<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= userdata.username %> &middot; Connector
    </title>
    <link rel="stylesheet" href="output.css">
    <link rel="icon" type="image/png" href="/images/logo.png">
</head>

<body>
    <!-- Toast Messages -->
    <div id="errorMsg"
        class="hidden fixed left-1/2 top-6 -translate-x-1/2 rounded-full bg-red-500/95 shadow-2xl shadow-black/40 border border-red-300/40 flex items-center justify-center z-50 px-4 py-2">
        <span class="te text-white text-sm font-semibold"></span>
    </div>
    <div id="successMsg"
        class="hidden fixed left-1/2 top-6 -translate-x-1/2 rounded-full bg-emerald-300/95 shadow-2xl shadow-black/40 border border-emerald-100/60 flex items-center justify-center z-50 px-4 py-2">
        <span class="ts text-black text-sm font-semibold"></span>
    </div>
    <div id="PhantomMsg"
        class="hidden fixed left-1/2 top-6 -translate-x-1/2 h-auto w-auto rounded-full bg-[#ab9ff2]/95 shadow-2xl shadow-black/40 border border-white/30 flex items-center justify-center z-50 px-4 py-2">
        <span class="p text-black text-sm font-semibold"></span>
    </div>

    <div class="main w-full h-[100dvh] flex flex-col sm:flex-row text-white bg-[#08080a] overflow-hidden">

        <!-- LEFT SIDEBAR (desktop only) -->
        <div class="left hidden sm:flex w-[14vw] h-screen flex-col justify-between items-center py-2 bg-zinc-900 shrink-0">
            <div class="flex gap-9 lg:gap-5 flex-col justify-center items-center">
                <img src="images/logo.png" class="w-11 h-11 rounded-full" alt="">
                <a href="/home"
                    class="flex gap-3 items-center px-3 font-bold font-sans hover:scale-[1.05] hover:cursor-pointer rounded-md bg-transparent lg:bg-zinc-800 lg:w-[11vw] h-12">
                    <img src="images/home.svg" class="rounded-full w-11 lg:w-7" alt="">
                    <span class="hidden lg:inline">Home</span>
                </a>
                <a href="/Vclips"
                    class="flex gap-3 items-center px-3 font-bold font-sans hover:scale-[1.05] hover:cursor-pointer bg-transparent lg:bg-[#ab9ff27a] rounded-md lg:w-[11vw] h-12">
                    <img src="images/Vclips.svg" class="w-8 lg:w-5" alt="">
                    <span class="hidden lg:inline">Vclips</span>
                </a>
                <a href="/post"
                    class="flex gap-3 items-center px-3 font-bold font-sans hover:scale-[1.05] hover:cursor-pointer bg-transparent lg:bg-zinc-800 rounded-md lg:w-[11vw] h-12">
                    <img src="images/post.svg" class="rounded-full w-11 lg:w-7" alt="">
                    <span class="hidden lg:inline">Post</span>
                </a>
                <% if(notifydata > 0){ %>
                    <a href="/Notify"
                        class="flex gap-3 items-center px-3 font-bold font-sans hover:scale-[1.05] hover:cursor-pointer bg-transparent lg:bg-zinc-800 rounded-md lg:w-[11vw] h-12">
                        <img src="images/notifyfalse.svg" class="rounded-full w-11 lg:w-7" alt="">
                        <span class="hidden lg:inline">Notify (<%= notifydata %>)</span>
                    </a>
                <% } else { %>
                    <a href="/Notify"
                        class="flex gap-3 items-center px-3 font-bold font-sans hover:scale-[1.05] hover:cursor-pointer bg-transparent lg:bg-zinc-800 rounded-md lg:w-[11vw] h-12">
                        <img src="images/notify.svg" class="rounded-full w-11 lg:w-7" alt="">
                        <span class="hidden lg:inline">Notify</span>
                    </a>
                <% } %>
                <a href="/Search"
                    class="flex gap-3 items-center px-3 font-bold font-sans hover:scale-[1.05] hover:cursor-pointer bg-transparent lg:bg-zinc-800 rounded-md lg:w-[11vw] h-12">
                    <img src="images/Search.svg" class="w-11 lg:w-7" alt="">
                    <span class="hidden lg:inline">Search</span>
                </a>
                <a href="/profile"
                    class="flex gap-3 items-center px-3 font-bold font-sans hover:scale-[1.05] hover:cursor-pointer bg-transparent lg:bg-zinc-800 rounded-md lg:w-[11vw] h-12">
                    <img src="<%= userdata.image %>" class="rounded-full w-11 h-11 lg:w-7 lg:h-7" alt="">
                    <span class="hidden lg:inline">Profile</span>
                </a>
            </div>
        </div>

        <!-- MAIN FEED AREA -->
        <!-- Mobile: takes full height minus bottom nav. Desktop: full screen -->
        <div class="right w-full flex-1 sm:h-screen sm:border-l sm:border-zinc-700 bg-[radial-gradient(circle_at_top,#171420_0%,#050506_42%,#000_100%)] sm:bg-black overflow-hidden">

            <div class="vfeed w-full h-full flex flex-col items-center sm:items-stretch snap-y snap-mandatory overflow-y-scroll [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden">

                <% alluserspost.forEach((post) => { %>
                <% if(post.image === "" && post.user){ %>

                <!-- SINGLE REEL CARD -->
                <div class="post relative w-full h-full snap-start shrink-0 overflow-hidden bg-black">

                    <!-- VIDEO: fills entire card -->
                    <video
                        src="<%= post.videos %>"
                        autoplay muted loop
                        poster="<%= post.thumbnail %>"
                        data-id="<%= post._id %>"
                        class="videoplay absolute inset-0 w-full h-full object-cover hover:cursor-pointer z-0 bg-black">
                    </video>

                    <!-- PLAY ICON -->
                    <img src="images/play.svg"
                        class="play hidden absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-16 z-10 pointer-events-none drop-shadow-2xl" alt="">

                    <!-- TOP GRADIENT SCRIM -->
                    <div class="absolute inset-x-0 top-0 h-36 z-10 pointer-events-none"
                        style="background: linear-gradient(to bottom, rgba(0,0,0,0.72) 0%, rgba(0,0,0,0.22) 55%, transparent 100%);">
                    </div>

                    <!-- BOTTOM GRADIENT SCRIM -->
                    <div class="absolute inset-x-0 bottom-0 h-64 z-10 pointer-events-none"
                        style="background: linear-gradient(to top, rgba(0,0,0,0.92) 0%, rgba(0,0,0,0.52) 48%, transparent 100%);">
                    </div>

                    <!-- TOP: USERNAME + FOLLOW -->
                    <div class="absolute top-4 left-4 right-4 sm:top-3 sm:left-3 sm:right-3 z-20 flex items-center justify-between gap-3 sm:gap-0">
                        <div class="flex items-center gap-2 min-w-0 sm:min-w-0">
                            <img src="<%= post.user.image %>"
                                class="w-10 h-10 sm:w-9 sm:h-9 rounded-full object-cover border-2 border-white/50 sm:border-white/40 shrink-0 shadow-lg sm:shadow-none shadow-black/40" alt="">
                            <a href="/home/<%= post.user._id %>" class="flex items-center gap-1 min-w-0 hover:opacity-80">
                                <span class="text-white font-semibold text-sm truncate"
                                    style="text-shadow:0 1px 4px rgba(0,0,0,0.8)">@<%= post.user.username %></span>
                                <% if(post.user.walletAddress){ %>
                                    <img src="/images/phantom_verified.svg" class="w-5 rounded-full shrink-0" alt="">
                                <% } %>
                            </a>
                        </div>
                        <% if(post.user._id.toString() !== userdata._id.toString()){ %>
                            <% if(post.user.follower.includes(userdata._id)){ %>
                                <button
                                    class="text-xs px-4 py-2 sm:py-1 bg-black/35 sm:bg-white/10 border border-white/35 sm:border-white/50 rounded-full font-semibold text-white hover:cursor-pointer hover:bg-white/15 backdrop-blur-md sm:backdrop-blur-sm transition shrink-0 sm:hover:scale-[1.07]"
                                    onclick="followuser('<%= post.user._id %>',this)">Unfollow</button>
                            <% } else { %>
                                <button
                                    class="text-xs px-5 sm:px-4 py-2 sm:py-1 bg-white sm:bg-white/20 text-black sm:text-white border border-white sm:border-white/60 rounded-full font-bold sm:font-semibold hover:cursor-pointer hover:bg-zinc-200 backdrop-blur-md sm:backdrop-blur-sm transition shrink-0 sm:hover:scale-[1.07]"
                                    onclick="followuser('<%= post.user._id %>',this)">Follow</button>
                            <% } %>
                        <% } %>
                    </div>

                    <!-- BOTTOM LEFT: DESCRIPTION -->
                    <p onclick="description('<%= post._id %>')"
                        id="description-<%= post._id %>"
                        class="vdescription absolute bottom-7 left-4 sm:bottom-6 sm:left-3 z-20 w-[68%] sm:w-[70%] max-h-[18vh] overflow-hidden line-clamp-2 text-sm leading-6 sm:leading-normal font-medium sm:font-thin text-white hover:cursor-pointer"
                        style="text-shadow: 0 1px 6px rgba(0,0,0,1);">
                        <% let r = Math.random() %>
                        <% if(r > 0.1 && r < 0.2){ %><span class="text-[#8ee6ff]">#</span>
                        <% } else if(r > 0.2 && r < 0.3){ %><span class="text-[#8ee6ff]">@</span>
                        <% } else if(r > 0.3){ %><span class="text-[#8ee6ff]">+</span>
                        <% } else { %><span class="text-[#8ee6ff]">*</span>
                        <% } %>
                        <%= post.description %>
                    </p>

                    <!-- BOTTOM RIGHT: ACTION BUTTONS -->
                    <div id="userinteract-<%= post._id %>"
                        class="absolute right-4 bottom-7 sm:right-3 sm:bottom-6 z-20 flex flex-col items-center gap-4 sm:gap-5">

                        <!-- LIKE -->
                        <div class="flex flex-col items-center gap-1">
                            <% if(post.likes.some(id => (id._id || id).toString() === userdata._id.toString())){ %>
                                <img src="images/liked.svg"
                                    class="likedv w-11 h-11 p-2 sm:w-7 sm:h-auto sm:p-0 rounded-full sm:rounded-none bg-black/35 sm:bg-transparent border border-white/15 sm:border-0 backdrop-blur-md sm:backdrop-blur-none hover:bg-white/10 hover:cursor-pointer transition sm:hover:scale-[1.1]"
                                    data-id="<%= post._id %>" onclick="likevpost('<%= post._id %>')">
                                <img src="images/unliked.svg"
                                    class="unlikedv w-11 h-11 p-2 sm:w-7 sm:h-auto sm:p-0 rounded-full sm:rounded-none bg-black/35 sm:bg-transparent border border-white/15 sm:border-0 backdrop-blur-md sm:backdrop-blur-none hover:bg-white/10 hover:cursor-pointer hidden transition sm:hover:scale-[1.1]"
                                    data-id="<%= post._id %>" onclick="likevpost('<%= post._id %>')">
                            <% } else { %>
                                <img src="images/liked.svg"
                                    class="likedv w-11 h-11 p-2 sm:w-7 sm:h-auto sm:p-0 rounded-full sm:rounded-none bg-black/35 sm:bg-transparent border border-white/15 sm:border-0 backdrop-blur-md sm:backdrop-blur-none hover:bg-white/10 hover:cursor-pointer hidden transition sm:hover:scale-[1.1]"
                                    data-id="<%= post._id %>" onclick="likevpost('<%= post._id %>')">
                                <img src="images/unliked.svg"
                                    class="unlikedv w-11 h-11 p-2 sm:w-7 sm:h-auto sm:p-0 rounded-full sm:rounded-none bg-black/35 sm:bg-transparent border border-white/15 sm:border-0 backdrop-blur-md sm:backdrop-blur-none hover:bg-white/10 hover:cursor-pointer transition sm:hover:scale-[1.1]"
                                    data-id="<%= post._id %>" onclick="likevpost('<%= post._id %>')">
                            <% } %>
                            <h2 class="likevcount text-xs font-bold drop-shadow" data-id="<%= post._id %>"><%= post.likes.length %></h2>
                        </div>

                        <!-- COMMENT -->
                        <div class="flex flex-col items-center gap-1">
                            <img src="images/comment.svg"
                                onclick="vopenbox(`<%= post._id %>`)"
                                class="comment w-11 h-11 p-2 sm:w-7 sm:h-auto sm:p-0 rounded-full sm:rounded-none bg-black/35 sm:bg-transparent border border-white/15 sm:border-0 backdrop-blur-md sm:backdrop-blur-none hover:bg-white/10 hover:cursor-pointer transition sm:hover:scale-[1.1]" alt="">
                            <h2 class="commentcount text-xs font-bold drop-shadow" data-id="<%= post._id %>"><%= post.comments.length %></h2>
                        </div>

                        <!-- SOUND -->
                        <% if(post.image === ""){ %>
                            <img src="images/offsound.svg"
                                class="playsound w-11 h-11 p-2 sm:w-7 sm:h-auto sm:p-0 rounded-full sm:rounded-none bg-black/35 sm:bg-transparent border border-white/15 sm:border-0 backdrop-blur-md sm:backdrop-blur-none hover:bg-white/10 hover:cursor-pointer transition sm:hover:scale-[1.1]" alt="">
                        <% } %>

                        <!-- SOL TIP -->
                        <% if(userdata.walletAddress && post.user.walletAddress && post.user._id.toString() !== userdata._id.toString()){ %>
                            <img src="images/solana.svg"
                                onclick="vopensol('<%= post._id %>')"
                                class="w-11 h-11 p-2 sm:w-8 sm:h-auto sm:p-0 rounded-full sm:rounded-none bg-black/35 sm:bg-transparent border border-white/15 sm:border-0 backdrop-blur-md sm:backdrop-blur-none hover:bg-white/10 hover:cursor-pointer transition sm:hover:scale-[1.1]" alt="">
                        <% } %>
                    </div>

                    <!-- COMMENT BOX OVERLAY -->
                    <div id="commentbox-<%= post._id %>"
                        class="commentbox hidden absolute inset-0 z-30 bg-[#101014] sm:bg-zinc-900 sm:inset-auto sm:top-1/2 sm:left-1/2 sm:-translate-x-1/2 sm:-translate-y-1/2 sm:h-[88vh] sm:w-[60vw] lg:w-[30vw] sm:rounded-xl border-white/10 sm:border-zinc-700 sm:border flex flex-col px-4 sm:px-3 py-4 sm:py-3 gap-4 sm:gap-3 shadow-2xl sm:shadow-none shadow-black/70">
                        <div class="flex items-center gap-4 mt-1 shrink-0">
                            <img src="images/back.svg"
                                class="vbackcomment-<%= post._id %> w-9 h-9 p-2 sm:w-5 sm:h-auto sm:p-0 rounded-full sm:rounded-none bg-white/10 sm:bg-transparent hover:bg-white/15 hover:cursor-pointer transition sm:hover:scale-[1.07]" alt="">
                            <p class="font-semibold sm:font-normal">Creative <strong class="text-[#ab9ff2] sm:text-yellow-300">Comments</strong></p>
                        </div>
                        <div data-id="<%= post._id %>"
                            class="userscommentbox w-full flex-1 flex flex-col justify-start items-start space-y-3 overflow-y-scroll [scrollbar-width:none] [&::-webkit-scrollbar]:hidden pr-1">
                            <% post.comments.reverse().forEach((c) => { %>
                                <div class="eachcomment border border-white/10 sm:border-zinc-700 bg-white/[0.04] sm:bg-transparent rounded-2xl sm:rounded-md flex flex-col w-full shrink-0 overflow-hidden">
                                    <div class="ucomment-<%= c._id %> flex justify-start items-start gap-2 px-3 py-2">
                                        <h1 class="nameofuser text-[#8ee6ff] sm:text-blue-500 shrink-0 text-sm font-semibold"><%= c.nameofuser %></h1>
                                        <p class="usercomment wrap-break-word text-sm text-zinc-200"><%= c.comment %></p>
                                    </div>
                                    <% c.replies.reverse().forEach((r) => { %>
                                        <div class="flex gap-2 px-3 py-2 sm:py-1 w-full items-center bg-black/20 sm:bg-zinc-800/50">
                                            <h1 class="text-[#8ee6ff] sm:text-blue-400 text-xs shrink-0">-> <%= r.replier %></h1>
                                            <p class="text-xs text-zinc-300"><%= r.reply %></p>
                                        </div>
                                    <% }) %>
                                    <div class="reply px-3 py-2">
                                        <div class="flex items-center gap-2">
                                            <textarea name="reply" id="reply-<%= c._id %>"
                                                placeholder="Reply..."
                                                class="replybox outline-none resize-none w-full rounded-xl sm:rounded-md h-10 sm:h-9 border border-white/10 sm:border-zinc-700 px-3 sm:px-2 py-2 sm:py-0 bg-black/25 sm:bg-zinc-800 text-sm placeholder:text-zinc-500 focus:border-[#ab9ff2]/60"></textarea>
                                            <img src="images/send.svg"
                                                onclick="reply('<%= post._id %>','<%= c._id %>','<%= userdata.username %>')"
                                                class="w-9 h-9 sm:w-7 sm:h-7 rounded-full bg-white border-white border p-2 sm:p-0 shrink-0 hover:bg-zinc-200 hover:cursor-pointer transition sm:hover:scale-[1.07]" alt="">
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                        <div class="flex items-center gap-3 pb-3 shrink-0">
                            <textarea id="comment-<%= post._id %>" placeholder="Comment Creatively..."
                                class="flex-1 border outline-none pt-3 border-white/10 sm:border-zinc-700 resize-none rounded-2xl sm:rounded-md px-3 sm:px-2 bg-black/30 sm:bg-zinc-800 h-12 sm:h-11 text-sm placeholder:text-zinc-500 focus:border-[#ab9ff2]/60"></textarea>
                            <button onclick="sendcomment(`<%= post._id %>`,'<%= userdata.username %>','<%= userdata._id %>')"
                                class="shrink-0" type="button">
                                <img src="images/send.svg" class="w-11 h-11 sm:w-10 sm:h-auto p-2 sm:p-0 rounded-full sm:rounded-none bg-white sm:bg-transparent hover:bg-zinc-200 hover:cursor-pointer transition sm:hover:scale-[1.09]" alt="">
                            </button>
                        </div>
                    </div>

                    <!-- SOL BOX OVERLAY -->
                    <div id="solbox-<%= post._id %>"
                        class="hidden absolute inset-0 z-30 bg-[#101014] sm:bg-zinc-900 sm:inset-auto sm:top-1/2 sm:left-1/2 sm:-translate-x-1/2 sm:-translate-y-1/2 sm:w-[60vw] lg:w-[30vw] sm:h-[90%] sm:rounded-xl border-white/10 sm:border-zinc-700 sm:border flex flex-col px-4 sm:px-3 shadow-2xl sm:shadow-none shadow-black/70">
                        <div class="flex items-center gap-4 mt-4 mb-2 shrink-0">
                            <img src="images/back.svg" id="backsol-<%= post._id %>"
                                class="w-9 h-9 p-2 sm:w-5 sm:h-auto sm:p-0 rounded-full sm:rounded-none bg-white/10 sm:bg-transparent hover:bg-white/15 hover:cursor-pointer transition sm:hover:scale-[1.07]" alt="">
                            <p class="font-semibold sm:font-normal">Creator <strong class="text-[#ab9ff2] sm:text-yellow-300">Supporters</strong></p>
                        </div>
                        <div id="solsenders-<%= post._id %>"
                            class="solsenders flex-1 flex flex-col overflow-y-scroll [scrollbar-width:none] [&::-webkit-scrollbar]:hidden gap-2 py-2">
                            <% post.sol.reverse().forEach((s) => { %>
                                <div class="senderdata border border-white/10 sm:border-zinc-700 bg-white/[0.04] sm:bg-transparent rounded-2xl sm:rounded-md w-full min-h-[82px] sm:h-[11vh] px-3 flex items-center gap-4 shrink-0">
                                    <img src="images/nft_verified.svg" class="w-7 shrink-0" alt="">
                                    <p class="text-sm text-zinc-200 sm:text-white"><strong class="text-[#f6d76f] sm:text-yellow-200"><%= s.amount %></strong> Sol sent by
                                        <strong onclick="searcheduserprofile('<%= s.senderId %>')"
                                            class="text-purple-300 hover:text-white hover:cursor-pointer"><%= s.sender %></strong>
                                    </p>
                                </div>
                            <% }) %>
                        </div>
                        <div class="flex flex-col justify-center items-center gap-5 py-6 shrink-0">
                            <div class="flex gap-3">
                                <button class="amount-btn rounded-2xl sm:rounded-md w-16 sm:w-12 h-12 border border-white/10 sm:border-zinc-700 bg-white/[0.04] sm:bg-transparent font-semibold hover:cursor-pointer hover:border-[#ab9ff2] sm:hover:border-purple-400 hover:bg-[#ab9ff2]/15 transition sm:hover:scale-[1.1]"
                                    onclick="selectsol(this,0.5)">0.5</button>
                                <button class="amount-btn rounded-2xl sm:rounded-md w-16 sm:w-12 h-12 border border-white/10 sm:border-zinc-700 bg-white/[0.04] sm:bg-transparent font-semibold hover:cursor-pointer hover:border-[#ab9ff2] sm:hover:border-purple-400 hover:bg-[#ab9ff2]/15 transition sm:hover:scale-[1.1]"
                                    onclick="selectsol(this,1)">1</button>
                                <button class="amount-btn rounded-2xl sm:rounded-md w-16 sm:w-12 h-12 border border-white/10 sm:border-zinc-700 bg-white/[0.04] sm:bg-transparent font-semibold hover:cursor-pointer hover:border-[#ab9ff2] sm:hover:border-purple-400 hover:bg-[#ab9ff2]/15 transition sm:hover:scale-[1.1]"
                                    onclick="selectsol(this,2)">2</button>
                            </div>
                            <button id="sendbtn" data-id="<%= post._id %>"
                                onclick="sendSolToCreator('<%= post.user.walletAddress %>','<%= post.user.username %>','<%= post._id %>','<%= userdata._id %>','<%= userdata.username %>')"
                                class="getsendbtn rounded-2xl sm:rounded-md bg-[#ab9ff2] sm:bg-purple-400 px-10 sm:px-8 h-12 text-black font-bold hover:cursor-pointer hover:bg-[#c6bcff] sm:hover:bg-purple-300 transition sm:hover:scale-[1.07]">Send SOL</button>
                        </div>
                    </div>

                </div>
                <!-- END REEL CARD -->

                <% } %>
                <% }) %>

            </div>
        </div>

        <!-- BOTTOM NAV (mobile only) -->
        <div class="flex sm:hidden w-full justify-between px-5 items-center bg-[#0c0c10]/95 backdrop-blur-md border-t border-white/10 shrink-0" style="height: env(safe-area-inset-bottom, 0px); min-height: 64px; padding-bottom: env(safe-area-inset-bottom, 8px);">
            <a href="/home" class="w-11 h-11 flex items-center justify-center rounded-full hover:bg-white/10"><img src="images/home.svg" class="rounded-full w-8" alt=""></a>
            <a href="/Vclips" class="w-11 h-11 flex items-center justify-center rounded-full bg-[#ab9ff2]/20 ring-1 ring-[#ab9ff2]/35"><img src="images/Vclips.svg" class="w-6" alt=""></a>
            <a href="/post" class="w-11 h-11 flex items-center justify-center rounded-full hover:bg-white/10"><img src="images/post.svg" class="rounded-full w-8" alt=""></a>
            <a href="/Search" class="w-11 h-11 flex items-center justify-center rounded-full hover:bg-white/10"><img src="images/Search.svg" class="w-8" alt=""></a>
            <a href="/profile" class="w-11 h-11 flex items-center justify-center rounded-full hover:bg-white/10"><img src="<%= userdata.image %>" class="rounded-full w-8 h-8 object-cover ring-1 ring-white/25" alt=""></a>
        </div>

    </div>

    <script src="https://unpkg.com/@solana/web3.js@latest/lib/index.iife.min.js"></script>
    <script src="/script.js"></script>
    <script src="/js/PhantomConnect.js"></script>
    <script>
        function searcheduserprofile(searcheduserid) {
            window.location.href = "/Search/" + searcheduserid;
        }
    </script>
</body>
</html>
