<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
</head>

<body>
    <!DOCTYPE html>
    <html lang="en">

    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>User Account</title>
        <link rel="stylesheet" href="/output.css">
    </head>

    <body>
        <div id="errorMsg"
            class="hidden fixed left-1/2 top-7 -translate-x-1/2 -translate-y-1/2 h-[5vh] rounded-md  bg-black  border border-zinc-600  flex items-center justify-center z-50 px-2">
            <span class="te text-white"></span></div>
        <div id="successMsg"
            class="hidden fixed left-1/2 top-7 -translate-x-1/2 -translate-y-1/2 h-[5vh] rounded-md  bg-black  border border-zinc-600  flex items-center justify-center z-50 px-2">
            <span class="ts text-white"></span></div>
        <div class="main relative w-full h-screen flex text-white bg-zinc-900">
            <div class="left sm:flex w-[14vw] h-screen hidden flex-col justify-between items-center py-2 bg-zinc-900">
                <div class="flex gap-9 lg:gap-5 flex-col justify-center items-center">
                    <button>Logo</button>
                    <a href="/home"
                        class="flex gap-3 items-center px-3 font-bold font-sans hover:scale-[1.05] hover:cursor-pointer rounded-md bg-transparent lg:bg-zinc-800  lg:w-[11vw] h-12"><img
                            src="/images/home.svg" class="rounded-full w-11 lg:w-7" alt=""><span
                            class="hidden lg:inline">Home</span></a>
                    <a href="/Vclips"
                        class="flex gap-3 items-center px-3 font-bold font-sans hover:scale-[1.05] hover:cursor-pointer bg-transparent lg:bg-zinc-800 rounded-md lg:w-[11vw] h-12"><img
                            src="/images/Vclips.svg" class="w-8 lg:w-5" alt=""><span
                            class="hidden lg:inline">Vclips</span></a>
                    <a href="/post"
                        class="flex gap-3 items-center px-3 font-bold font-sans hover:scale-[1.05] hover:cursor-pointer bg-transparent lg:bg-zinc-800 rounded-md lg:w-[11vw] h-12"><img
                            src="/images/post.svg" class="rounded-full w-11 lg:w-7" alt=""><span
                            class="hidden lg:inline">Post</span></a>
                    <a href="/Search"
                        class="flex gap-3 items-center px-3 font-bold font-sans hover:scale-[1.05] hover:cursor-pointer bg-transparent lg:bg-zinc-800 rounded-md lg:w-[11vw] h-12"><img
                            src="/images/Search.svg" class="w-11 lg:w-7" alt=""><span
                            class="hidden lg:inline">Search</span></a>
                    <a href="/profile"
                        class="flex gap-3 items-center px-3 font-bold font-sans hover:scale-[1.05] hover:cursor-pointer bg-transparent lg:bg-[#ab9ff27a] rounded-md lg:w-[11vw] h-12"><img
                            src="<%= myposts.user.image %>" class="rounded-full w-11 lg:w-7" alt=""><span
                            class="hidden lg:inline">Profile</span></a>
                </div>
            </div>
            <div
                class="right relative w-full h-screen border flex items-center justify-center border-zinc-700 bg-zinc-900">
                <div
                    class="deletepopup hidden absolute top-5 left-1/2 -translate-x-1/2 z-100 w-[55vw] md:w-[30vw] lg:w-[20vw] h-[15vh] flex flex-col justify-center items-center gap-5 rounded-md bg-zinc-900 border border-white px-2">
                    <h1>Are You Sure ?</h1>
                    <div class="deleteornot flex gap-7">
                        <button
                            class="cancel rounded-md bg-zinc-800 px-2 hover:scale-[1.07] hover:cursor-pointer">Cancel</button>
                        <a href="/profile/deletepost/<%= myposts._id %>"
                            class="rounded-md bg-red-600 px-2 hover:scale-[1.07] hover:cursor-pointer">Delete</a>
                    </div>
                </div>
                <div
                    class='feed relative max-w-auto h-screen flex flex-col <%= myposts.image !== "" ? "justify-center":"" %> overflow-y-scroll [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden '>

                    <div class="post relative  flex justify-center items-center">
                        <div
                            class="userspost m-4 h-[90vh] sm:h-auto px-3 py-2 flex flex-col gap-3 border border-zinc-700">
                            <div class="postheader flex justify-between">
                                <div class="leftheader flex gap-3">
                                    <img src="<%= myposts.user.image %>" class="w-7 rounded-full" alt="">
                                    <h1>@<%= myposts.user.username %>
                                    </h1>
                                </div>
                                <div class="rightheader flex gap-5">
                                    <%if(myposts.user._id.toString()===userdata._id.toString()) { %>
                                        <img src="/images/delete.svg"
                                            class="deletebtn w-5 hover:scale-[1.2] hover:cursor-pointer" alt="">
                                        <img src="/images/edit.svg"
                                            class="edit w-5 hover:scale-[1.2] hover:cursor-pointer" alt="">
                                        <% } %>

                                            <% if(myposts.nftMint){ %>
                                                <div class="relative"
                                                    onmouseenter="this.querySelector('.nft-tooltip').classList.remove('hidden')"
                                                    onmouseleave="this.querySelector('.nft-tooltip').classList.add('hidden')"
                                                    onclick="this.querySelector('.nft-tooltip').classList.toggle('hidden')">
                                                    <img src="/images/nft_verified.svg"
                                                        class="verified-nft w-6 cursor-pointer" alt="">
                                                    <div
                                                        class="nft-tooltip hidden absolute bottom-8 left-1/2 -translate-x-1/2 bg-black text-white text-xs px-2 py-1 rounded whitespace-nowrap">
                                                        NFT Verified ✓
                                                    </div>
                                                </div>
                                                <% } %>
                                </div>
                            </div>
                            <% if(myposts.image==="" ){ %>
                                <video src="<%= myposts.videos %>" autoplay muted loop data-id="<%= myposts._id %>"
                                    class="videoplay pointer-events-none  aspect-9/11 h-[80vh] w-[99vw] sm:w-[50vw] md:w-[45vw] lg:w-[35vw] xl:w-[25vw] object-cover rounded-2xl"></video>
                                <% } else{ %>
                                    <img src="<%= myposts.image %>"
                                        class="w-[70vw] sm:w-[55vw] md:w-[40vw] lg:w-[30vw] aspect-9/11" alt="">
                                    <% } %>
                                        <div id="userinteract-<%= myposts._id %>"
                                            class="likecommentsdelete flex gap-16 px-2 h-7 justify-between items-center">
                                            <% if(myposts.image==="" ){ %>
                                                <div class="view flex gap-2 w-7 mr-2">
                                                    <img src="/images/view.svg" class="w-5" alt="view">
                                                    <h2 class="font-bold">
                                                        <%= myposts.views.length %>
                                                    </h2>
                                                </div>
                                                <% } %>
                                                    <div class="likeorunlike flex gap-2 w-7 mr-2">
                                                        <% if(myposts.likes.includes(userdata._id)){ %>
                                                            <img src="/images/liked.svg"
                                                                class="liked   w-5 hover:scale-[1.2] hover:cursor-pointer"
                                                                data-id="<%= myposts._id %>"
                                                                onclick="likepost('<%= myposts._id %>')">
                                                            <img src="/images/unliked.svg"
                                                                class="unliked w-5 hover:scale-[1.2] hover:cursor-pointer hidden"
                                                                data-id="<%= myposts._id %>"
                                                                onclick="likepost('<%= myposts._id %>')">
                                                            <% } else { %>
                                                                <img src="/images/liked.svg"
                                                                    class="liked   w-5 hover:scale-[1.2] hover:cursor-pointer hidden"
                                                                    data-id="<%= myposts._id %>"
                                                                    onclick="likepost('<%= myposts._id %>')">
                                                                <img src="/images/unliked.svg"
                                                                    class="unliked w-5 hover:scale-[1.2] hover:cursor-pointer"
                                                                    data-id="<%= myposts._id %>"
                                                                    onclick="likepost('<%= myposts._id %>')">
                                                                <% } %>
                                                                    <h2 class="likecount font-bold font-sans"
                                                                        data-id="<%= myposts._id %>">
                                                                        <%= myposts.likes.length %>
                                                                    </h2>
                                                    </div>
                                                    <div class="flex gap-2 w-7 mr-2">
                                                        <img src="/images/comment.svg"
                                                            onclick="openbox(`<%= myposts._id %>`)"
                                                            class="comment w-5 hover:scale-[1.2] hover:cursor-pointer"
                                                            alt="">
                                                        <h2 class="commentcount font-bold font-sans"
                                                            data-id="<%= myposts._id %>">
                                                            <%= myposts.comments.length %>
                                                        </h2>
                                                    </div>

                                                    <% if(myposts.image==="" ){ %>
                                                        <img src="/images/offsound.svg"
                                                            class="playsound w-5 hover:scale-[1.2] hover:cursor-pointer"
                                                            alt="">
                                                        <% }%>

                                        </div>
                                        <p onclick="postdescription('<%= myposts._id %>')"
                                            id="postdescription-<%= myposts._id %>"
                                            class="pdescription max-h-[27vh] w-[24vw] left-5 line-clamp-2 font-thin hover:cursor-pointer">
                                            <% let r=Math.random() %>
                                                <% if(r>0.1 && r<0.2 ){ %>
                                                        <span class="text-blue-500">₥</span>
                                                        <% } else if(r>0.2 && r<0.3){ %>
                                                                <span class="text-blue-500">µ</span>
                                                                <% } else if(r>0.3){ %>
                                                                    <span class="text-blue-500">✓</span>
                                                                    <% } else if(r<0.1){ %>
                                                                        <span class="text-blue-500">⌀</span>
                                                                        <% } %>
                                                                            <%= myposts.description %>
                                        </p>
                        </div>

                        <div id="commentbox-<%= myposts._id %>"
                            class="hidden absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 md:static md:top-auto md:left-auto md:translate-x-0 md:translate-y-0 px-3 py-2 gap-5 h-[90%] border border-zinc-700 flex flex-col bg-zinc-900 rounded-xl ">
                            <div class="flex items-center gap-5">
                                <img src="/images/back.svg"
                                    class="backcomment-<%= myposts._id %> w-5 my-2 hover:scale-[1.07] hover:cursor-pointer"
                                    alt="">
                                <p class="flex gap-2">People Comment<strong class="text-yellow-300">On Your
                                        Creation</strong></p>
                            </div>
                            <div data-id="<%= myposts._id %>"
                                class="userscommentbox w-[65vw] sm:w-[60vw] md:w-[30vw] flex-1 flex-col justify-start items-start space-y-4 overflow-y-scroll [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden">
                                <% myposts.comments.reverse().forEach((c)=>{ %>
                                    <div
                                        class="eachcomment border flex justify-start items-start gap-2 px-3 py-2 border-zinc-700 w-[80vw] sm:w-[60vw] md:w-[29vw] min-h-[11vh]">
                                        <h1 class="text-blue-600 shrink-0">
                                            <%= c.nameofuser %>
                                        </h1>
                                        <p class="wrap-break-word">
                                            <%= c.comment %>
                                        </p>
                                    </div>
                                    <% }) %>
                            </div>

                            <div class="flex mb-3 justify-center items-center gap-3 ">
                                <textarea id="comment-<%= myposts._id %>" placeholder="Comment Creatively"
                                    class="w-[52vw] sm:w-[25vw] border pt-3 border-zinc-700 resize-none  rounded-md px-2 bg-transparent"></textarea>
                                <button onclick="sendcomment(`<%= myposts._id %>`,'<%= userdata.username %>')"
                                    class="w-16 bg-blue-700 rounded-md px-2" type="submit">Send</button>
                            </div>
                        </div>
                    </div>




                </div>
                <div
                    class="editpost hidden w-[95vw] py-3 sm:py-0 sm:w-[85vw] lg:w-[70vw] h-[80vh] sm:h-[70vh] bg-zinc-900 border border-zinc-600 rounded-2xl absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 flex flex-col sm:flex-row gap-3 sm:gap-0 items-center overflow-y-scroll sm:overflow-hidden">
                    <div class="postshowbox w-full sm:w-1/2 h-full flex justify-center items-center">
                        <% if(myposts.image==="" ) { %>
                            <video src="<%= myposts.videos %>" class="aspect-9/11 h-[65vh]" autoplay muted></video>
                            <% } else { %>
                                <img src="<%= myposts.image %>" class="aspect-9/11 h-[65vh]" alt="">
                                <% }%>
                    </div>
                    <div
                        class="posteditbox w-full sm:w-1/2 h-full px-4 flex sm:border sm:border-zinc-800 justify-center items-center flex-col gap-7">
                        <p class="text-xs"><strong>Update</strong> Your Description ✓</p>
                        <textarea name="udescription" id="udescription"
                            class="resize-none w-full h-[25vh] p-2 overflow-y-scroll [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden border border-zinc-700 rounded-md"><%= myposts.description %></textarea>
                        <button onclick="editpost('<%= myposts._id %>')"
                            class="rounded-md h-[5vh] flex items-center hover:scale-[1.1] hover:cursor-pointer bg-white text-black px-2 border border-zinc-700">Update</button>
                    </div>
                    <img src="/images/close.svg" id="close"
                        class="absolute top-5 right-5 hover:scale-[1.07] hover:cursor-pointer" alt="">
                </div>
            </div>

            <div class="flex sm:hidden w-full justify-between px-2 absolute bottom-5">
                <a href="/home"><img src="/images/home.svg" class="rounded-full w-9" alt=""></a>
                <a href="/Vclips"><img src="/images/Vclips.svg" class="w-6" alt=""></a>
                <a href="/post"><img src="/images/post.svg" class="rounded-full w-9" alt=""></a>
                <a href="/Search"><img src="/images/Search.svg" class="w-9" alt=""></a>
                <a href="/profile"><img src="<%= userdata.image %>" class="rounded-full w-9" alt=""></a>
            </div>

        </div>
        <script src="/script.js " defer></script>
    </body>

    </html>